{
  "population_id": "ecoli_research_v1_population",
  "config_version": "1.0.0",
  "cohort_id": "ecoli_research_v1",
  "genome_qc": {
    "note": "Broad operational bounds for usable E. coli assemblies, not biological limits. Fail removes an assembly from genomic analyses; warning keeps it and is reported.",
    "fail_length_min": 2500000,
    "fail_length_max": 8000000,
    "warn_length_min": 4000000,
    "warn_length_max": 6500000,
    "warn_contigs_max": 500,
    "warn_n50_min": 20000,
    "warn_ambiguous_fraction_max": 0.005,
    "fail_ambiguous_fraction_max": 0.05
  },
  "mlst": {
    "scheme": "ecoli_achtman_4",
    "loci": ["adk", "fumC", "gyrB", "icd", "mdh", "purA", "recA"]
  },
  "phylogroup": {
    "method": "EzClermont in silico Clermont PCR",
    "assigned": ["A", "B1", "B2", "C", "D", "E", "F", "G"],
    "cryptic": ["cryptic"]
  },
  "lineage": {
    "definition": "lineage_id = ST<n> for an assigned Achtman ST; UNKNOWN otherwise",
    "major_lineage_min_isolates": 50,
    "top_n": 20
  },
  "holdout_eligibility": {
    "population": ["pr5_eligible_isolate", "genome_qc_not_fail"],
    "lineage": ["population", "mlst_assigned"],
    "country": ["population", "known_country"],
    "temporal": ["population", "valid_collection_year"],
    "source": ["population", "known_source_category"],
    "known_source_categories": ["human", "animal", "food", "environment", "other"]
  },
  "feasibility_rules": {
    "decision": "HUMAN_REVIEW_REQUIRED",
    "note": "Provisional screening rules on binary R/S endpoints of population-eligible isolates. They describe whether a holdout could be populated; they are not study decisions.",
    "lineage": {"feasible": {"min_R": 50, "min_S": 50, "min_sts_with_both": 5, "max_largest_st_fraction": 0.5},
                "marginal": {"min_R": 20, "min_S": 20, "min_sts_with_both": 3}},
    "country": {"min_group_isolates": 50, "feasible": {"min_groups_with_both": 3, "max_largest_fraction": 0.8},
                "marginal": {"min_groups_with_both": 2}},
    "temporal": {"recent_quantile": 0.8, "feasible": {"min_recent": 100, "min_recent_R": 20, "min_recent_S": 20},
                 "marginal": {"min_recent": 30, "min_recent_R": 5, "min_recent_S": 5}},
    "source": {"min_group_isolates": 50, "feasible": {"min_groups_with_both": 3},
               "marginal": {"min_groups_with_both": 2}},
    "min_both_per_group": 10
  },
  "review_flags": {
    "note": "Thresholds that raise a human-review flag. Nothing is excluded by them.",
    "min_lineage_isolates": 50,
    "lineage_single_country_fraction": 0.9,
    "lineage_single_source_fraction": 0.9,
    "lineage_after_cutoff_fraction": 0.9,
    "dominant_lineage_fraction": 0.1,
    "min_resistant_for_concentration": 20,
    "resistance_single_lineage_fraction": 0.5,
    "resistance_single_cluster_fraction": 0.2,
    "resistance_single_project_fraction": 0.5,
    "lineage_single_project_fraction": 0.8,
    "large_snp_cluster_isolates": 50,
    "low_mlst_success_fraction": 0.9
  }
}
